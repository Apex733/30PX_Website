{
  "name": "30px-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "tsc && vite build",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ORDERS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply ORDERS_DB --remote",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "convert-images": "node scripts/convert-to-webp.mjs",
    "convert-images:dry": "node scripts/convert-to-webp.mjs --dry"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@number-flow/react": "^0.5.10",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/three": "^0.182.0",
    "boneyard-js": "^1.8.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cobe": "^0.6.5",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^11.0.3",
    "lenis": "^1.3.17",
    "lucide-react": "^0.314.0",
    "motion": "^12.26.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "svix": "^1.61.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-image-optimizer": "^2.0.3",
    "wrangler": "^4.11.1"
  }
}
